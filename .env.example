# Environment & Security
PROJECT_NAME="RBDGTC Referral Portal API"
ENVIRONMENT="development"
DEBUG=true

# Security & JWT (Change in production!)
# Generate a strong key with: openssl rand -hex 32
SECRET_KEY="rbdgtc-secret-super-secure-key-change-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database URL
# For instant local testing (zero-setup):
DATABASE_URL="sqlite+aiosqlite:///./portal.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://postgres:yourpassword@db.xyz.supabase.co:5432/postgres"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173"

# Uploads Configuration
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_BYTES=5242880 # 5 MB
